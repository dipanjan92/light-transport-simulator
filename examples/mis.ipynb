    "def tone_mapping(hdr_image, gamma=2.2):\n",
    "    ldr_image = hdr_image / (1.0 + hdr_image)\n",
    "    ldr_image = np.power(ldr_image, 1.0 / gamma)\n",
    "    return np.clip(ldr_image, 0, 1)\n",
    "\n",
